public function rules(): array
    {
        $allowedTypes = 'pdf,doc,docx,xls,xlsx,jpg,jpeg,png,webp';

        return [
            'file_type' => ['required', 'string', 'in:project_detail,general_doc,drawing'],
            'documents'   => ['required', 'array', 'min:1'],
            'documents.*' => ['required', 'file', 'mimes:' . $allowedTypes, 'max:20480'], // 20MB max
        ];
    }
